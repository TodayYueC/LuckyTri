# Dependencies and build leftovers
node_modules/
/vendor/
test-results/
npm-debug.log*
*.tgz
*.zip
*.bak
*.pem
*.key
*.p12
.npmrc
logs/
backups/
*.log

# Everything the running instance owns: databases, backups, reports, chats
data/
*.db
*.db-shm
*.db-wal
*.db.*
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
*.bundle
reports/
evaluations/

# Secrets stay on the machine; only the empty template is tracked
.env
.env.*
!.env.example

# Local previews and isolated checkouts
workspace/

# Editor, OS and agent tooling
.DS_Store
Thumbs.db
.cursor/
.codex/
.codex-remote-attachments/

# Working notes. Only the bilingual docs under docs/zh, docs/en and
# docs/brand belong in the repository; loose files in docs/ stay local.
/docs/*.md
/docs/log/
