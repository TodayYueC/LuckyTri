{
  "name": "luckytri",
  "version": "0.9.1",
  "description": "让由技术诞生的她，在时间、记忆、相遇与选择中逐渐形成自己的方向",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TodayYueC/LuckyTri.git"
  },
  "bugs": {
    "url": "https://github.com/TodayYueC/LuckyTri/issues"
  },
  "homepage": "https://github.com/TodayYueC/LuckyTri",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "launch": "node scripts/launch.js",
    "start": "node --env-file-if-exists=.env scripts/start-server.js",
    "dev:ui": "vite --config studio-web/vite.config.ts",
    "build:ui": "vite build --config studio-web/vite.config.ts",
    "test": "node --import ./tests/awake.mjs --test tests/*.test.js",
    "test:clock": "node scripts/test-clock.js",
    "audit:sent": "node --env-file-if-exists=.env scripts/audit-sent.js",
    "test:ui": "node tests/ui-smoke.js && node tests/ta-ui.mjs",
    "setup": "node scripts/setup.js",
    "stop": "node --env-file-if-exists=.env scripts/stop.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "docs:build": "node scripts/build-guide.js",
    "format": "prettier --write server studio-web scripts tests package.json",
    "format:check": "prettier --check server studio-web scripts tests package.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "marked": "^18.0.13",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vue": "^3.5.43"
  }
}
