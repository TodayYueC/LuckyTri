HOST=127.0.0.1
PORT=3210
# Set both tokens before connecting QQ. Admin token protects UI/API.
ADMIN_TOKEN=
ONEBOT_TOKEN=
# Optional: credentials can also be saved from the local management UI.
LLM_API_KEY=
# Optional: automatic database backups while the server runs.
# BACKUP_INTERVAL_HOURS=24   # 0 turns them off
# BACKUP_KEEP=7
# BACKUP_TRACE_DAYS=1        # keep this many days of model call traces in a backup
# BACKUP_DIR=data/backups
