# LuckyTri local configuration / 本机配置
# Copy to .env, fill what you need and restart. Never commit .env.
# 复制为 .env，按需填写后重启服务。不要提交 .env。

HOST=127.0.0.1
PORT=3210

# Required when HOST is not local. Protects the studio and its API.
# 监听非本机地址时必须设置，用来保护管理界面与接口。
ADMIN_TOKEN=

# --- Connect QQ: pick one / 连接 QQ：二选一 ---
# Either set this in .env or choose in the studio under Connect QQ.
# 在这里设置，或在管理界面「连接 QQ」里选择。
# LUCKYTRI_CHANNEL=onebot   # onebot | qqbot. When set, the studio cannot change it. / 设置后界面里不能更改

# OneBot 11 (reverse WebSocket at /onebot/v11/ws)
ONEBOT_TOKEN=

# QQ official bot (AppID and AppSecret from the QQ open platform)
# QQ 官方机器人（QQ 开放平台里的 AppID 与 AppSecret）
# QQBOT_APP_ID=
# QQBOT_APP_SECRET=

# --- Models / 模型 ---
# Optional: credentials can also be saved from the studio.
# 可选：也可以在管理界面里保存。
LLM_API_KEY=
# Optional independent knowledge embedding credential (also configurable in the studio).
# 可选：独立的知识向量服务密钥（也可在管理界面配置）。
EMBEDDING_API_KEY=

# --- Images / 图片读取 ---
# Larger originals are resized/compressed before reaching the model; originals stay unchanged.
# 大图自动压缩后交给模型，不修改原图。/ Source limit 4–64 MiB, model limit 1–4 MiB.
# VISION_SOURCE_MAX_MB=32
# VISION_MODEL_MAX_MB=4
# VISION_DOWNLOAD_TIMEOUT_SECONDS=30

# --- Backups / 备份 ---
# Automatic database backups while the server runs. / 服务运行期间自动备份数据库。
# BACKUP_INTERVAL_HOURS=24   # 0 turns them off / 0 表示关闭
# BACKUP_KEEP=7
# BACKUP_TRACE_DAYS=1        # days of model call traces kept in a backup / 备份里保留几天的模型调用记录
# BACKUP_DIR=data/backups

# --- Data import / 数据导入 ---
# Maximum uploaded data package size in GiB (1–100). / 数据文件最大 GiB，范围 1–100。
# DATA_TRANSFER_MAX_GB=10
